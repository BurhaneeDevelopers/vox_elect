#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check for .env files in commit
if git diff --cached --name-only | grep -E '\.env'; then
  echo "❌ ERROR: .env file detected in commit!"
  echo "Remove .env files from staging area:"
  echo "  git reset HEAD .env.local"
  exit 1
fi

# Run type check
npm run typecheck

# Run tests on staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v '\.d\.ts$' || true)

if [ -n "$STAGED_FILES" ]; then
  npm test -- --bail --findRelatedTests --passWithNoTests $STAGED_FILES
fi
